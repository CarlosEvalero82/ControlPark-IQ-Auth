{
    "info": {
        "name": "ControlPark-IQ · API de autenticación (GA7-220501096-AA5-EV02)",
        "description": "Pruebas de la API de registro e inicio de sesión de ControlPark-IQ. Antes de ejecutar: iniciar el proyecto Spring Boot (puerto 8080) y seleccionar el entorno 'ControlPark-IQ Local'. Ejecutar la colección completa con Runner (en orden): la petición R1 genera un sufijo aleatorio, así la colección se puede repetir sin vaciar la tabla.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080"
        },
        {
            "key": "sufijo",
            "value": "0001"
        }
    ],
    "item": [
        {
            "name": "Registro",
            "item": [
                {
                    "name": "R1 · Registro correcto (rol PORTERIA)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.collectionVariables.set('sufijo', String(Math.floor(1000 + Math.random() * 9000)));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Código HTTP 201', function () { pm.response.to.have.status(201); });",
                                    "pm.test('Responde en menos de 2 segundos', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
                                    "pm.test('La respuesta es JSON', function () { pm.response.to.be.json; });",
                                    "pm.test('Mensaje: Usuario registrado correctamente', function () { pm.expect(pm.response.json().mensaje).to.eql(\"Usuario registrado correctamente\"); });",
                                    "pm.test('exito = true', function () { pm.expect(pm.response.json().exito).to.eql(true); });",
                                    "pm.test('La respuesta nunca devuelve la contraseña', function () { pm.expect(pm.response.text()).to.not.include('contrasena'); });"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
